# Cấu hình Server
PORT=3000

# Bắt buộc CSDL thật (dừng server nếu ở fallback)
STRICT_DB=false

# Mật khẩu mẫu cho Quản trị viên (:Account {accountId: "ACC001", role: "ADMIN"})
ADMIN_DEMO_PASSWORD=Admin@123

# Mật khẩu mẫu cho Nhân viên (Staff: STAFF001, STAFF002, STAFF003)
STAFF_DEMO_PASSWORD=NhanVien@123

# Cấu hình Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Cấu hình Redis
# Có thể dùng REDIS_URL (rediss://...) cho Upstash/Redis Cloud, hoặc REDIS_HOST/PORT/PASSWORD
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=
REDIS_REGION=

# Cấu hình Bảo mật Brute-force & Session (tính bằng giây)
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
SESSION_TTL_SECONDS=3600
DEMO_SEED_TTL_SECONDS=3600
FREEZE_SECONDS=900

# Cấu hình Chống tấn công theo IP (IP Defense)
IP_FAIL_WINDOW_SECONDS=900
IP_BLOCK_SECONDS=600
IP_MAX_FAILS=20
IP_MAX_ACCOUNTS=5
TRUST_PROXY=false
DEMO_MODE=true
