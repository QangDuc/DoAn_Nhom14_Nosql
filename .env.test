# ==============================================================================
# Cấu hình Môi trường Kiểm thử Tách biệt (Test Environment)
# Tuyệt đối không dùng chung cổng 7687 và 6379 của môi trường Demo
# ==============================================================================
PORT=3001
NODE_ENV=test
STRICT_DB=false
ALLOW_FALLBACK_ANALYTICS=true

# CSDL Neo4j Test (Cổng riêng 7688)
ADMIN_DEMO_PASSWORD=MatKhau@123
STAFF_DEMO_PASSWORD=TestStaff@123
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=test_password_123

# CSDL Redis Test (Cổng riêng 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Cấu hình TTL ngắn phục vụ kiểm thử nhanh (Lock 2 giây)
LOGIN_FAIL_WINDOW_SECONDS=10
LOGIN_LOCK_SECONDS=2
LOGIN_MAX_ATTEMPTS=5
SESSION_TTL_SECONDS=3600
DEMO_SEED_TTL_SECONDS=3600
FREEZE_SECONDS=900

# Cấu hình Chống tấn công IP trong Test
IP_FAIL_WINDOW_SECONDS=10
IP_BLOCK_SECONDS=5
IP_MAX_FAILS=20
IP_MAX_ACCOUNTS=5
TRUST_PROXY=false
DEMO_MODE=true

